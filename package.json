{
  "name": "newsr-billing-inventory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:network": "vite --host",
    "api": "sh -c 'test -f dist/index.html || npm run build; node --dns-result-order=ipv4first server/index.js'",
    "dev:all": "sh -c 'node server/index.js & vite --host'",
    "build": "vite build",
    "start": "NODE_ENV=production node --dns-result-order=ipv4first server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^0.511.0",
    "pg": "^8.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.19"
  }
}
